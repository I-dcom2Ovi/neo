const generateBtn = document.getElementById('generateBtn');
const codeDisplay = document.getElementById('codeDisplay');
const urlInput = document.getElementById('urlInput');

// Function to generate a random code
function generateCode(length = 6) {
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
  let code = '';
  for(let i = 0; i < length; i++) {
    code += chars.charAt(Math.floor(Math.random() * chars.length));
  }
  return code;
}

generateBtn.addEventListener('click', () => {
  const url = urlInput.value.trim();
  if(!url) {
    codeDisplay.innerHTML = 'Please enter a valid URL!';
    return;
  }

  const code = generateCode();
  // Store the code + URL in localStorage (so you can use it later if needed)
  localStorage.setItem(code, url);

  // Display a clickable link with the code
  codeDisplay.innerHTML = `Your code: <a href="${url}" target="_blank">${code}</a>`;
});

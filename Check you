// Function to show confirmation
function showConfirmation() {
  const popup = document.getElementById('confirmPopup');
  popup.classList.add('show');

  // Automatically disappear after 2 seconds
  setTimeout(() => {
    popup.classList.remove('show');
    // You can call your code generator here AFTER the popup disappears
    generateCodeAfterConfirmation();
  }, 2000);
}

// Example code generator function
function generateCodeAfterConfirmation() {
  const url = document.getElementById('urlInput').value.trim();
  if(!url) return alert("Enter a URL first!");
  
  const code = Math.random().toString(36).substring(2,8).toUpperCase();
  localStorage.setItem(code, url);
  
  const codeDisplay = document.getElementById('codeDisplay');
  codeDisplay.innerHTML = `Your code: <a href="${url}" target="_blank">${code}</a>`;
}

// Hook to your generate button
document.getElementById('generateBtn').addEventListener('click', showConfirmation);/* Confirmation popup style */
#confirmPopup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  background: rgba(0,0,0,0.9);
  color: #00ffff;
  padding: 30px 50px;
  font-size: 1.5rem;
  font-family: 'Arial', sans-serif;
  border: 2px solid #00ffff;
  border-radius: 15px;
  text-align: center;
  z-index: 9999;
  pointer-events: none;
  transition: transform 0.3s ease, opacity 0.3s ease;
  opacity: 0;
}

#confirmPopup.show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
}
